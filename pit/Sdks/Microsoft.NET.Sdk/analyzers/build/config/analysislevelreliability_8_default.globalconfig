# NOTE: Requires **VS2019 16.7** or later

# 'Reliability' Rules from '8.0' release with 'Default' analysis mode
# Description: 'Reliability' Rules with enabled-by-default state from '8.0' release with 'Default' analysis mode. Rules that are first released in a version later than '8.0' are disabled.

is_global = true

global_level = -99


# CA2022: Avoid inexact read with 'Stream.Read'
dotnet_diagnostic.CA2022.severity = none

# CA2023: Invalid braces in message template
dotnet_diagnostic.CA2023.severity = none

# CA2024: Do not use 'StreamReader.EndOfStream' in async methods
dotnet_diagnostic.CA2024.severity = none

# CA2026: Prefer JsonElement.Parse over JsonDocument.Parse().RootElement
dotnet_diagnostic.CA2026.severity = none

# CA2027: Cancel Task.Delay after Task.WhenAny completes
dotnet_diagnostic.CA2027.severity = none

# CA2028: Avoid redundant 'Regex.IsMatch' call before 'Regex.Match'
dotnet_diagnostic.CA2028.severity = none
