# NOTE: Requires **VS2019 16.7** or later

# Rules from '10.0' release with 'Default' analysis mode
# Description: Rules with enabled-by-default state from '10.0' release with 'Default' analysis mode. Rules that are first released in a version later than '10.0' are disabled.

is_global = true

global_level = -100


# CA1516: Use cross-platform intrinsics
dotnet_diagnostic.CA1516.severity = none

# CA1517: Use 'ReadOnlySpan<T>' or 'ReadOnlyMemory<T>' instead of 'Span<T>' or 'Memory<T>'
dotnet_diagnostic.CA1517.severity = none

# CA1876: Do not use 'AsParallel' in 'foreach'
dotnet_diagnostic.CA1876.severity = none

# CA1877: Collapse consecutive Path.Combine or Path.Join operations
dotnet_diagnostic.CA1877.severity = none

# CA2026: Prefer JsonElement.Parse over JsonDocument.Parse().RootElement
dotnet_diagnostic.CA2026.severity = none

# CA2027: Cancel Task.Delay after Task.WhenAny completes
dotnet_diagnostic.CA2027.severity = none

# CA2028: Avoid redundant 'Regex.IsMatch' call before 'Regex.Match'
dotnet_diagnostic.CA2028.severity = none

# CA2267: Quote whitespace in file-based program directive values
dotnet_diagnostic.CA2267.severity = none
